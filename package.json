{
  "name": "ai-guard",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that warns before sending sensitive data to AI chat sites.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:i18n": "node scripts/gen-i18n.mjs",
    "gen:manifests": "node scripts/gen-manifests.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "verify": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.10"
  }
}
